---
import { NAVIGATION } from '../../daten/navigation';
import { BETRIEB } from '../../daten/betrieb';
import { Icon } from 'astro-icon/components';
import { Picture } from 'astro:assets';

/* Das Logo laeuft durch die Bildpipeline, nicht ueber public/.
   Als PNG in public/ wurden bei jedem Seitenaufruf 101 KB geladen und dann
   auf 44 bis 64 px gezeichnet: der groesste einzelne Download der ganzen
   Seite. Ueber die Pipeline sind es wenige KB in AVIF mit PNG-Rueckfall. */
import logo from '../../bilder/logo.png';

const aktuell = Astro.url.pathname;

function istAktiv(pfad: string): boolean {
  if (pfad === '/') return aktuell === '/';
  return aktuell.startsWith(pfad);
}

/* Die sieben Punkte werden auf die beiden Seiten des Siegels verteilt.
   Vier links, drei rechts: rechts steht zusaetzlich der Kontaktknopf, sodass
   beide Seiten am Ende etwa gleich breit sind. */
const NAVI_LINKS = NAVIGATION.slice(0, 4);
const NAVI_RECHTS = NAVIGATION.slice(4);
---

<header class="kopfzeile" data-kopfzeile>
  {/* Ein einziges `nav` um alles: zwei Listen mit demselben Namen waeren
      fuer die Sprachausgabe zwei gleich benannte Bereiche. Der Logo-Link
      gehoert inhaltlich dazu, er fuehrt zur Startseite. */}
  <nav class="container kopfzeile-innen" aria-label="Hauptnavigation">
    <ul class="kopfzeile-liste kopfzeile-liste-links">
      {
        NAVI_LINKS.map((punkt) => (
          <li>
            <a href={punkt.pfad} aria-current={istAktiv(punkt.pfad) ? 'page' : undefined}>
              {punkt.name}
            </a>
          </li>
        ))
      }
    </ul>

    {/* Die Mitte ist ein Platzhalter in genau Siegelbreite. Beide Seiten
        daneben sind `flex: 1`, damit sitzt das Siegel exakt mittig — ohne
        eine einzige ausgerechnete Zahl. */}
    <div class="kopfzeile-mitte">
      {/* Zierde links und rechts vom Siegel. Nur auf schmalen Bildschirmen:
          dort steht neben dem Siegel nichts, und die leere Flaeche wirkt
          zufaellig. Auf dem Desktop stehen dort die Menuepunkte — eine
          Zeichnung dazwischen waere Gedraenge. */}
      <span class="kopfzeile-zierde zierde-gerste" aria-hidden="true"></span>
      <span class="kopfzeile-zierde zierde-hopfen" aria-hidden="true"></span>
      <a class="kopfzeile-marke" href="/" aria-label={`${BETRIEB.kurzname}, zur Startseite`}>
        {/* PLATZHALTER: 300-px-PNG. Wird durch die Vektordatei ersetzt, sobald
            diese vorliegt (OFFENE-FRAGEN Nr. 16). Blockiert den Livegang. */}
        <Picture
          src={logo}
          formats={['avif', 'webp']}
          widths={[64, 128, 192]}
          sizes="76px"
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <div class="kopfzeile-rechts">
      <ul class="kopfzeile-liste">
        {
          NAVI_RECHTS.map((punkt) => (
            <li>
              <a href={punkt.pfad} aria-current={istAktiv(punkt.pfad) ? 'page' : undefined}>
                {punkt.name}
              </a>
            </li>
          ))
        }
      </ul>

      <a class="kopfzeile-kontakt" href="/kontakt/">Kontakt</a>

      <button
        class="kopfzeile-menueknopf"
        type="button"
        aria-expanded="false"
        aria-controls="mobiles-menue"
        data-menueknopf
      >
        <span class="sr-only" data-menue-beschriftung>Menü öffnen</span>
        {/* Sichtbarer Zustandswechsel. Bleibt der Knopf ein Burger, waehrend
            das Menue offen ist, fehlt der offensichtliche Weg zurueck — und
            das Menue liegt bildschirmfuellend davor. */}
        <Icon name="ph:list" class="symbol-auf" width="28" height="28" aria-hidden="true" />
        <Icon name="ph:x" class="symbol-zu" width="28" height="28" aria-hidden="true" />
      </button>
    </div>
  </nav>
</header>

{/* Tippflaeche am oberen Rand, um die Leiste zurueckzuholen.

    Sie liegt genau ueber dem Sicherheitsbereich — auf einem iPhone also unter
    der Dynamic Island, auf Android unter der Statusleiste. Wer oben tippt,
    bekommt die Leiste zurueck, egal wie weit unten er steht.

    Aktiv ist sie nur, solange die Leiste weggefahren ist: sonst laege eine
    unsichtbare Flaeche ueber dem Seitenanfang und finge dort Tipper ab. */}
<button class="kopf-holen" type="button" data-kopf-holen hidden>
  <span class="sr-only">Menüleiste einblenden</span>
  <span class="kopf-holen-griff" aria-hidden="true"></span>
</button>

{/* Bewusst AUSSERHALB der Kopfzeile.
    `backdrop-filter` an der Kopfzeile macht sie zum Bezugsrahmen fuer
    `position: fixed` — genau wie `filter` und `transform`. Solange das Menue
    darin lag, bezog sich sein `inset` auf die Leiste statt auf das Fenster:
    es war 390 x 96 px gross statt bildschirmfuellend und liess die Seite
    durchscheinen. Auf einem Bildschirmfoto sah der geschlossene Zustand
    richtig aus, deshalb ist der Fehler lange nicht aufgefallen. */}
<div class="mobiles-menue" id="mobiles-menue" hidden data-mobiles-menue>
  <nav aria-label="Menü">
    <ul>
      {
        NAVIGATION.map((punkt, i) => (
          <li style={`--index: ${i}`}>
            <a href={punkt.pfad} aria-current={istAktiv(punkt.pfad) ? 'page' : undefined}>
              {punkt.name}
            </a>
          </li>
        ))
      }
      <li style={`--index: ${NAVIGATION.length}`}>
        <a href="/kontakt/">Kontakt</a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .kopfzeile {
    position: sticky;
    top: 0;
    z-index: var(--db-ebene-klebend);
    background: var(--kopf-flaeche);
    backdrop-filter: var(--kopf-weichzeichner);
    border-bottom: 1px solid var(--kopf-linie);
    /* Platz fuer Dynamic Island, Notch oder Statusleiste. Auf Geraeten ohne
       so etwas ist der Wert 0 und es aendert sich nichts. */
    padding-top: env(safe-area-inset-top, 0px);
    transition: transform var(--db-dauer-normal) var(--db-easing-standard);
  }

  /* Beim Abwaertsscrollen weg, beim Aufwaertsscrollen zurueck. Auf einem
     Handy im Hochformat frisst eine dauerhaft sichtbare Leiste ein Zehntel
     der Flaeche, und dies ist eine Seite zum Lesen.

     Die Leiste faehrt um ihre volle Hoehe PLUS den Ueberstand des Siegels
     nach oben. Vorher waren es nur 100 %, und das Siegel haengt unten heraus:
     beim Wegfahren blieb genau dieser Teil stehen und man sah ein halb
     abgeschnittenes Logo mitten am oberen Rand. */
  .kopfzeile[data-versteckt] {
    transform: translateY(
      calc(-100% - var(--kopf-siegel) * var(--kopf-siegel-ueberstand))
    );
  }

  /* Und das Siegel schrumpft dabei nach oben weg, statt einfach mitzufahren.
     Auf einem iPhone laeuft es damit genau dort hinein, wo die Dynamic Island
     sitzt — es sieht aus, als verschwaende es dahinter. Auf allen anderen
     Geraeten ist es schlicht ein sauberes Wegblenden. */
  .kopfzeile-marke {
    transition:
      transform var(--db-dauer-normal) var(--db-easing-standard),
      opacity var(--db-dauer-schnell) var(--db-easing-standard);
  }

  .kopfzeile[data-versteckt] .kopfzeile-marke {
    transform: translateX(-50%) translateY(-45%) scale(0.4);
    opacity: 0;
  }

  .kopfzeile-innen {
    display: flex;
    align-items: center;
    gap: var(--db-space-md);
    min-height: var(--kopf-hoehe);
  }

  /* -------------------------------------------------------------------------
     Das Siegel
     ---------------------------------------------------------------------- */

  .kopfzeile-mitte {
    position: relative;
    align-self: stretch;
    flex: 0 0 var(--kopf-siegel);
  }

  .kopfzeile-marke {
    position: absolute;
    left: 50%;
    /* Haengt um den eingestellten Anteil unter der Leiste heraus. */
    top: calc(
      var(--kopf-hoehe) - var(--kopf-siegel) +
        var(--kopf-siegel) * var(--kopf-siegel-ueberstand)
    );
    width: var(--kopf-siegel);
    height: var(--kopf-siegel);
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    /* Deckend, damit die Unterkante der Leiste hinter dem Siegel verschwindet
       statt mitten hindurchzulaufen. */
    background: var(--kopf-siegel-flaeche);
    border: 1px solid var(--kopf-linie);
    border-radius: 50%;
    box-shadow: var(--kopf-siegel-schatten);
    line-height: 0;
    z-index: 1;
  }

  .kopfzeile-marke img {
    width: calc(var(--kopf-siegel) * 0.74);
    height: auto;
  }

  /* -------------------------------------------------------------------------
     Zierde neben dem Siegel

     Dieselben Dateien wie bei den grossen Hintergrundmotiven, hier nur klein.
     Sie sind reine Dekoration, fangen keine Klicks und liegen hinter dem
     Siegel — es soll das Siegel rahmen, nicht mit ihm konkurrieren.
     ---------------------------------------------------------------------- */

  .kopfzeile-zierde {
    display: none;
    position: absolute;
    top: 50%;
    height: 2.1rem;
    background: var(--db-malz-700);
    opacity: 0.22;
    pointer-events: none;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .zierde-gerste {
    right: calc(100% + 0.5rem);
    aspect-ratio: 235 / 512;
    transform: translateY(-52%) rotate(-14deg);
    -webkit-mask-image: url('/motive/gerste.svg');
    mask-image: url('/motive/gerste.svg');
  }

  .zierde-hopfen {
    left: calc(100% + 0.5rem);
    aspect-ratio: 313 / 512;
    transform: translateY(-46%) rotate(13deg);
    -webkit-mask-image: url('/motive/hopfen.svg');
    mask-image: url('/motive/hopfen.svg');
  }

  /* -------------------------------------------------------------------------
     Die beiden Haelften
     ---------------------------------------------------------------------- */

  /* Gleiches Wachstum links wie rechts: nur so bleibt die Mitte die Mitte. */
  .kopfzeile-liste-links,
  .kopfzeile-rechts {
    flex: 1;
    min-width: 0;
  }

  .kopfzeile-rechts {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--db-space-md);
  }

  .kopfzeile-liste {
    display: flex;
    gap: var(--db-space-md);
    list-style: none;
    margin: 0;
  }

  .kopfzeile-liste a {
    display: block;
    font-size: var(--db-text-sm);
    font-weight: var(--db-weight-medium);
    color: var(--db-text);
    text-decoration: none;
    padding-block: var(--db-space-2xs);
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .kopfzeile-liste a[aria-current='page'] {
    font-family: var(--db-font-display);
    font-weight: var(--db-weight-semibold);
    border-bottom-color: var(--kopf-aktiv-linie);
  }

  .kopfzeile-kontakt {
    flex-shrink: 0;
    font-size: var(--db-text-sm);
    font-weight: var(--db-weight-medium);
    color: var(--knopf-still-text);
    text-decoration: none;
    border: 1px solid var(--knopf-still-rahmen);
    border-radius: var(--knopf-primaer-radius);
    padding: 0.4rem 0.9rem;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .kopfzeile-kontakt:hover {
      background: var(--knopf-still-flaeche-hover);
      border-color: var(--knopf-still-rahmen-hover);
    }
  }

  .kopfzeile-menueknopf {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--db-space-2xs);
    color: var(--db-text-ueberschrift);
    transition: transform var(--db-dauer-sofort) var(--db-easing-standard);
  }

  /* Auf dem Handy ist das das meistgedrueckte Element der Seite, und es gab
     bisher gar keine Rueckmeldung. Kraeftiger als bei den Knoepfen, weil die
     Flaeche klein ist. */
  .kopfzeile-menueknopf:active {
    transform: scale(0.92);
  }

  .kopfzeile-menueknopf .symbol-zu,
  .kopfzeile-menueknopf[aria-expanded='true'] .symbol-auf {
    display: none;
  }

  .kopfzeile-menueknopf[aria-expanded='true'] .symbol-zu {
    display: block;
  }

  /* Umbruch bei 1150 px, nicht 1024: die deutschen Labels sind lang
     ("Verkaufsstellen", "Events & Verleih"), das Siegel braucht in der Mitte
     zusaetzlich Platz, und eine zweizeilige Navigation ist ein Baufehler. */
  @media (max-width: 1149px) {
    /* Nicht die Listen selbst ausblenden, sondern nur ihre Punkte: die leeren
       Listen bleiben als gleich grosse Haelften stehen und halten das Siegel
       weiter in der Mitte. */
    .kopfzeile-liste li,
    .kopfzeile-kontakt {
      display: none;
    }

    .kopfzeile-menueknopf {
      display: block;
    }

    .kopfzeile-mitte {
      flex-basis: var(--kopf-siegel-mobil);
    }

    .kopfzeile-marke {
      width: var(--kopf-siegel-mobil);
      height: var(--kopf-siegel-mobil);
      top: calc(
        var(--kopf-hoehe) - var(--kopf-siegel-mobil) +
          var(--kopf-siegel-mobil) * var(--kopf-siegel-ueberstand)
      );
    }

    .kopfzeile-marke img {
      width: calc(var(--kopf-siegel-mobil) * 0.74);
    }

    /* Erst hier, wo die Menuepunkte weg sind, ist neben dem Siegel Platz. */
    .kopfzeile-zierde {
      display: block;
    }
  }

  /* Ganz schmale Geraete: dort steht die Zierde dem Menueknopf im Weg. */
  @media (max-width: 359px) {
    .kopfzeile-zierde {
      display: none;
    }
  }

  @media (prefers-contrast: more) {
    .kopfzeile-zierde {
      display: none;
    }
  }

  /* -------------------------------------------------------------------------
     Tippflaeche zum Zurueckholen der Leiste
     ---------------------------------------------------------------------- */

  .kopf-holen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Der Sicherheitsbereich plus ein schmaler Streifen darunter. Mehr nicht:
       jede zusaetzliche Hoehe wuerde Tipper auf dem Seiteninhalt abfangen. */
    height: calc(env(safe-area-inset-top, 0px) + 1.35rem);
    z-index: var(--db-ebene-klebend);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0.2rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .kopf-holen[hidden] {
    display: none;
  }

  /* Nur dort, wo die Leiste auch als Menue dient. Auf dem Desktop holt sie
     schon das Hochscrollen zurueck, und ein unsichtbarer Streifen ueber dem
     oberen Seitenrand finge dort Klicks ab, die dem Inhalt gelten. */
  @media (min-width: 1150px) {
    .kopf-holen {
      display: none;
    }
  }

  /* Ein kleiner Griff als Hinweis, dass hier etwas passiert. Bewusst
     unauffaellig: er darf den Blick nicht vom Inhalt wegziehen. */
  .kopf-holen-griff {
    width: 2.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: var(--db-malz-700);
    opacity: 0.28;
    transition: opacity var(--db-dauer-schnell) var(--db-easing-standard);
  }

  .kopf-holen:active .kopf-holen-griff {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .kopfzeile-marke,
    .kopf-holen-griff {
      transition: none;
    }
  }

  /* Das Menue deckt das ganze Fenster ab, liegt aber UNTER der Kopfzeile:
     so bleiben Siegel und Menueknopf sichtbar und bedienbar, waehrend es
     offen ist. Der obere Innenabstand haelt den ersten Punkt frei vom
     Siegel, das unter die Leiste ragt. */
  .mobiles-menue {
    position: fixed;
    inset: 0;
    background: var(--db-flaeche);
    z-index: calc(var(--db-ebene-klebend) - 1);
    padding: calc(var(--kopf-hoehe) + var(--db-space-2xl)) var(--db-rand)
      var(--db-space-xl);
    overflow-y: auto;
    opacity: 1;
    transition: opacity var(--db-dauer-schnell) var(--db-easing-standard);
  }

  .mobiles-menue[hidden] {
    display: none;
  }

  /* Ausblenden statt schlagartigem Verschwinden. Ein bildschirmfuellendes
     Feld, das ohne Uebergang weg ist, liest sich als Fehler.
     Der Austritt ist mit 180 ms schneller als der gestaffelte Eintritt:
     langsam beim Entscheiden, schnell beim Antworten. */
  .mobiles-menue[data-schliesst] {
    opacity: 0;
    pointer-events: none;
  }

  .mobiles-menue ul {
    list-style: none;
    margin: 0;
    display: grid;
    gap: var(--db-space-md);
  }

  .mobiles-menue a {
    font-family: var(--db-font-display);
    font-size: var(--db-text-2xl);
    font-weight: var(--db-weight-semibold);
    color: var(--db-text-ueberschrift);
    text-decoration: none;
  }

  .mobiles-menue a[aria-current='page'] {
    color: var(--db-text-link);
  }

  /* Gestaffeltes Einblenden. Kurze Versaetze: lange Verzoegerungen lassen
     das Menue langsam wirken. */
  .mobiles-menue li {
    opacity: 0;
    transform: translateY(12px);
    animation: menue-rein var(--db-dauer-normal) var(--db-easing-standard) forwards;
    animation-delay: calc(var(--index) * var(--db-staffel));
  }

  @keyframes menue-rein {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kopfzeile {
      transition: none;
    }

    .mobiles-menue li {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const kopf = document.querySelector<HTMLElement>('[data-kopfzeile]');
  const holen = document.querySelector<HTMLButtonElement>('[data-kopf-holen]');
  const knopf = document.querySelector<HTMLButtonElement>('[data-menueknopf]');
  const menue = document.querySelector<HTMLElement>('[data-mobiles-menue]');
  const beschriftung = document.querySelector<HTMLElement>('[data-menue-beschriftung]');

  if (knopf && menue) {
    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)');

    const schliessen = () => {
      knopf.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (beschriftung) beschriftung.textContent = 'Menü öffnen';

      if (wenigerBewegung.matches) {
        menue.hidden = true;
        return;
      }

      /* Erst ausblenden, dann aus dem Baum nehmen. Ohne das Warten waere
         der Uebergang nicht sichtbar, weil hidden sofort greift. */
      menue.setAttribute('data-schliesst', '');

      let erledigt = false;
      const fertig = () => {
        if (erledigt) return;
        erledigt = true;
        menue.hidden = true;
        menue.removeAttribute('data-schliesst');
        menue.removeEventListener('transitionend', aufUebergang);
      };

      /* transitionend blubbert: jede Bewegung eines Kindelements wuerde
         sonst das Menue sofort schliessen. Deshalb auf das Menue selbst
         und auf opacity einschraenken. */
      const aufUebergang = (e: TransitionEvent) => {
        if (e.target !== menue || e.propertyName !== 'opacity') return;
        fertig();
      };

      menue.addEventListener('transitionend', aufUebergang);
      // Sicherheitsnetz, falls das Ereignis ausbleibt (Tab im Hintergrund).
      window.setTimeout(fertig, 500);
    };

    const oeffnen = () => {
      knopf.setAttribute('aria-expanded', 'true');
      menue.removeAttribute('data-schliesst');
      menue.hidden = false;
      document.body.style.overflow = 'hidden';
      if (beschriftung) beschriftung.textContent = 'Menü schließen';
    };

    const umschalten = () => {
      const offen = knopf.getAttribute('aria-expanded') === 'true';
      if (offen) schliessen();
      else oeffnen();
    };

    knopf.addEventListener('click', umschalten);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menue.hidden) {
        umschalten();
        knopf.focus();
      }
    });
  }

  /* Kopfzeile beim Abwaertsscrollen ausblenden.
     Kein window.addEventListener("scroll"): das laeuft bei jedem Bild neu und
     erzwingt dauerndes Nachrechnen. Stattdessen ein IntersectionObserver auf
     einen unsichtbaren Wachposten am Seitenanfang. */
  if (kopf) {
    let zuletztVersteckt = false;

    const wachposten = document.createElement('div');
    wachposten.setAttribute('aria-hidden', 'true');
    wachposten.style.cssText = 'position:absolute;top:0;left:0;height:1px;width:1px;';
    document.body.prepend(wachposten);

    let obenSichtbar = true;

    /* Die Tippflaeche gibt es nur, solange die Leiste weg ist. Sonst laege
       eine unsichtbare Flaeche ueber dem Seitenanfang und finge dort Tipper
       ab, die dem Inhalt gelten. */
    const verstecken = (ja: boolean) => {
      if (ja) kopf.setAttribute('data-versteckt', '');
      else kopf.removeAttribute('data-versteckt');
      if (holen) holen.hidden = !ja;
    };

    holen?.addEventListener('click', () => {
      verstecken(false);
      /* Ohne das Zuruecksetzen wuerde der naechste Beobachterlauf die Leiste
         sofort wieder wegschicken, weil er den Zustand von vorher kennt. */
      zuletztVersteckt = false;
    });

    const beobachter = new IntersectionObserver(
      ([eintrag]) => {
        obenSichtbar = eintrag.isIntersecting;
        if (obenSichtbar) verstecken(false);
      },
      { threshold: 0 },
    );
    beobachter.observe(wachposten);

    /* Richtungserkennung ueber die Sichtbarkeit eines zweiten Wachpostens,
       der der Kopfzeile folgt. So bleibt alles ereignisfrei. */
    const folger = document.createElement('div');
    folger.setAttribute('aria-hidden', 'true');
    folger.style.cssText = 'position:absolute;top:60vh;left:0;height:1px;width:1px;';
    document.body.prepend(folger);

    const folgerBeobachter = new IntersectionObserver(
      ([eintrag]) => {
        if (obenSichtbar) return;
        zuletztVersteckt = !eintrag.isIntersecting;
        verstecken(zuletztVersteckt);
      },
      { threshold: 0 },
    );
    folgerBeobachter.observe(folger);
  }
</script>

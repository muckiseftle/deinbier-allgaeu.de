---
import { Picture } from 'astro:assets';

/**
 * Bild mit Platzhalter.
 *
 * Wo Material fehlt, steht ein gestalteter Platzhalter, kein hochskaliertes
 * unscharfes Foto. Jede Verwendung ohne Quelle gehoert in OFFENE-FRAGEN
 * Nr. 15.
 *
 * Breite und Hoehe setzt Picture selbst, damit beim Laden nichts springt.
 */
interface Props {
  quelle?: ImageMetadata;
  alt: string;
  breiten?: number[];
  sizes?: string;
  laden?: 'lazy' | 'eager';
  /** Text im Platzhalter, wenn die Quelle fehlt. */
  hinweis?: string;
  /** Seitenverhaeltnis des Platzhalters, etwa "3 / 2" oder "4 / 5". */
  verhaeltnis?: string;
  /**
   * Format der Rueckfallebene. Ohne Angabe waehlt Astro das Format der
   * Quelle — bei einem PNG also PNG, und das ist fuer eine Fotoaufnahme
   * katastrophal: die freigestellte Flasche wog als PNG 1,8 MB, als AVIF
   * 26 KB. Geladen wird der Rueckfall zwar nur ohne AVIF- und
   * WebP-Unterstuetzung, ausgeliefert wird er aber immer.
   *
   * `webp` ist seit 2020 in allen Browsern verfuegbar und deshalb hier ein
   * sicherer Rueckfall.
   */
  rueckfall?: 'png' | 'jpeg' | 'webp';
  klasse?: string;
}

const {
  quelle,
  alt,
  breiten = [480, 800, 1200, 1600],
  sizes = '(max-width: 767px) 100vw, 50vw',
  laden = 'lazy',
  hinweis,
  verhaeltnis = '3 / 2',
  rueckfall,
  klasse,
} = Astro.props;
---

{
  quelle ? (
    <Picture
      class:list={['bild', klasse]}
      src={quelle}
      formats={['avif', 'webp']}
      fallbackFormat={rueckfall}
      widths={breiten}
      sizes={sizes}
      alt={alt}
      loading={laden}
      /* Ein Bild, das sofort geladen wird, ist in aller Regel auch das
         groesste sichtbare Element. Ohne diesen Hinweis reiht der Browser es
         hinter Schriften und Stylesheets ein. */
      fetchpriority={laden === 'eager' ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div
      class:list={['bild-platzhalter', klasse]}
      style={`aspect-ratio: ${verhaeltnis}`}
      role="img"
      aria-label={alt}
    >
      <span>{hinweis ?? 'Foto folgt'}</span>
    </div>
  )
}

<style>
  .bild {
    width: 100%;
    height: auto;
    border-radius: var(--db-radius-md);
  }

  .bild-platzhalter {
    width: 100%;
    background: var(--platzhalter-flaeche);
    border-radius: var(--db-radius-md);
    display: grid;
    place-items: center;
    color: var(--platzhalter-zeichen);
    font-size: var(--db-text-sm);
    letter-spacing: var(--db-tracking-weit);
    text-transform: uppercase;
    text-align: center;
    padding: var(--db-space-md);
  }
</style>

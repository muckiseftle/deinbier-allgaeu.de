---
interface Props {
  href?: string;
  art?: 'primaer' | 'bier' | 'still';
  extern?: boolean;
  klasse?: string;
}

const { href, art = 'primaer', extern = false, klasse } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element
  class:list={['knopf', `knopf-${art}`, klasse]}
  href={href}
  type={href ? undefined : 'button'}
  rel={extern ? 'noopener noreferrer' : undefined}
  target={extern ? '_blank' : undefined}
>
  <slot />
  {extern && <span class="sr-only">(öffnet in neuem Tab)</span>}
</Element>

<style is:global>
  .knopf {
    display: inline-flex;
    align-items: center;
    gap: var(--db-space-2xs);
    padding: var(--knopf-primaer-polster);
    border-radius: var(--knopf-primaer-radius);
    border: 1px solid transparent;
    font-family: var(--db-font-text);
    font-size: var(--db-text-base);
    font-weight: var(--db-weight-medium);
    text-decoration: none;
    cursor: pointer;
    /* Eine Knopfbeschriftung, die auf zwei Zeilen umbricht, ist ein
       kaputter Knopf. */
    white-space: nowrap;
    transition:
      transform var(--knopf-dauer) var(--db-easing-standard),
      background-color var(--knopf-dauer) var(--db-easing-standard),
      border-color var(--knopf-dauer) var(--db-easing-standard),
      box-shadow var(--knopf-dauer) var(--db-easing-standard);
  }

  /* Sofortige Rueckmeldung beim Druecken: der Knopf senkt sich, wie ein
     echter Taster. */
  .knopf:active {
    transform: scale(var(--knopf-druck));
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .knopf:hover {
      transform: translateY(var(--knopf-hub));
    }
  }

  .knopf-primaer {
    background: var(--knopf-primaer-flaeche);
    color: var(--knopf-primaer-text);
    box-shadow: var(--knopf-primaer-schatten);
  }

  @media (hover: hover) and (pointer: fine) {
    .knopf-primaer:hover {
      background: var(--knopf-primaer-flaeche-hover);
      box-shadow: var(--knopf-primaer-schatten-hover);
    }
  }

  /* Dunkler Text auf Bernstein. Cremefarbener Text ergaebe 3,26:1 und
     faellt durch (DESIGN.md 9.2). */
  .knopf-bier {
    background: var(--knopf-bier-flaeche);
    color: var(--knopf-bier-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .knopf-bier:hover {
      background: var(--knopf-bier-flaeche-hover);
    }
  }

  .knopf-still {
    background: transparent;
    color: var(--knopf-still-text);
    border-color: var(--knopf-still-rahmen);
  }

  @media (hover: hover) and (pointer: fine) {
    .knopf-still:hover {
      background: var(--knopf-still-flaeche-hover);
      border-color: var(--knopf-still-rahmen-hover);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knopf {
      transition: none;
    }
    .knopf:hover,
    .knopf:active {
      transform: none;
    }
  }
</style>

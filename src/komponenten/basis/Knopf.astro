---
/**
 * Die Stile liegen bewusst nicht hier, sondern in src/styles/knoepfe.css.
 * Grund: Die Altersabfrage und einzelne Seiten setzen die Klassen direkt,
 * ohne diese Komponente einzubinden. Laegen die Regeln hier, faenden sie
 * sich auf genau den Seiten nicht, auf denen die Komponente fehlt.
 */
interface Props {
  href?: string;
  art?: 'primaer' | 'bier' | 'still';
  extern?: boolean;
  klasse?: string;
}

const { href, art = 'primaer', extern = false, klasse } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element
  class:list={['knopf', `knopf-${art}`, klasse]}
  href={href}
  type={href ? undefined : 'button'}
  rel={extern ? 'noopener noreferrer' : undefined}
  target={extern ? '_blank' : undefined}
>
  <slot />
  {extern && <span class="sr-only">(öffnet in neuem Tab)</span>}
</Element>

---
/**
 * Grosses Hintergrundmotiv: Hopfendolde oder Gerstenaehre.
 *
 * Bewusst KEIN gekacheltes Muster. Ein Muster wird zur Tapete und macht die
 * Flaeche unruhig; ein einzelnes, sehr grosses Motiv gibt der Flaeche Tiefe,
 * ohne sich in den Vordergrund zu draengen.
 *
 * Der Zeiger ist ein Lichtpunkt. Wo er steht, glimmen die Linien goldgelb
 * auf und werden nach aussen hin schwaecher; die Kanten der Zeichnung
 * leuchten kraeftig, die Binnenzeichnung deutlich zurueckhaltender. Das ist
 * der Unterschied zu einer Kontur, die einfach gleichmaessig aufleuchtet:
 * es sieht aus, als truege man eine Lampe ueber ein geprägtes Blatt.
 *
 * Aufbau: dieselbe Zeichnung zweimal uebereinander. Unten der blasse Grund,
 * darueber eine goldene Kopie, die mit einem radialen Verlauf maskiert ist.
 * Die Maske sitzt an einem HTML-Element und nicht an einer SVG-Gruppe, weil
 * CSS-Masken auf SVG-Kindern je nach Browser unterschiedlich greifen.
 */
interface Props {
  art: 'hopfen' | 'gerste';
  /**
   * An welcher Seite das Motiv aus dem Rand ragt. `frei` heisst: die
   * Komponente positioniert sich gar nicht selbst, sondern laesst sich von
   * aussen setzen — gebraucht, sobald zwei Motive nebeneinander stehen.
   */
  seite?: 'links' | 'rechts' | 'frei';
  /**
   * Hoehe als CSS-Laenge. Zahlen gelten als Pixel; gedacht sind 380 bis 780.
   * Ein Prozentwert bezieht sich auf den umgebenden Bezugsrahmen — im
   * Hero-Bild ist das die Etikettenfassung, sodass das Motiv mit dem Foto
   * mitwaechst statt bei jeder Fensterbreite anders zu sitzen.
   */
  hoehe?: number | string;
  /** Zusaetzliche Drehung in Grad. */
  drehung?: number;
  /**
   * Wie weit das Motiv ueber den Rand hinausragt, als Anteil seiner eigenen
   * Breite. Auf grossen Flaechen darf das viel sein; in einem kleinen
   * Bildausschnitt bleibt sonst zu wenig von der Form uebrig, um sie zu
   * erkennen.
   */
  ueberstand?: number;
  klasse?: string;
}

const {
  art,
  seite = 'rechts',
  hoehe = 520,
  drehung = 0,
  ueberstand = 0.26,
  klasse,
} = Astro.props;

const r = (n: number) => Math.round(n * 10) / 10;

/* ---------------------------------------------------------------------------
   Hopfendolde

   Der entscheidende Punkt, und der Grund fuer zwei verworfene Fassungen:
   eine Dolde hat KEINE glatte Aussenlinie. Ihr Umriss entsteht aus den
   Spitzen der aeusseren Deckblaetter selbst. Zeichnet man erst ein Ei und
   legt dann Schuppen hinein, kommt eine Karotte heraus — genau so hat der
   Betreiber die zweite Fassung genannt, und er hatte recht.

   Richtig ist: nur Deckblaetter. Fuenf Lagen, jede faechert nach aussen
   auf, jede folgende sitzt tiefer und ist kleiner. Was aussen steht, bildet
   den Rand.
------------------------------------------------------------------------- */

/**
 * Ein Deckblatt: eine an beiden Enden spitze Linse, um ihren Mittelpunkt
 * gedreht. Die Drehung wird hier ausgerechnet und nicht als
 * `transform`-Attribut gesetzt, damit alle Pfade im selben Koordinatenraum
 * liegen — sonst stimmt die Rueckrechnung der Zeigerposition nicht mehr.
 */
function deckblatt(cx: number, cy: number, b: number, h: number, grad: number) {
  const a = (grad * Math.PI) / 180;
  const cos = Math.cos(a);
  const sin = Math.sin(a);
  const p = (x: number, y: number) =>
    `${r(cx + x * cos - y * sin)} ${r(cy + x * sin + y * cos)}`;
  return (
    `M${p(0, -h / 2)}` +
    `C${p(b, -h / 6)} ${p(b, h / 6)} ${p(0, h / 2)}` +
    `C${p(-b, h / 6)} ${p(-b, -h / 6)} ${p(0, -h / 2)}Z`
  );
}

/**
 * Eine Schuppe des Doldenkoerpers: oben breit gerundet, nach unten zur
 * Spitze zulaufend.
 *
 * Zwei Formen sind noetig. Lauter beidseitig spitze Blaetter ergeben ein
 * Lilienornament, das nach aussen aussticht; erst breite, gerundete
 * Schuppen, die sich stark ueberlappen, schliessen die Form zu einem Koerper.
 */
function schuppe(cx: number, cy: number, b: number, h: number) {
  return (
    `M${r(cx - b)} ${r(cy - h * 0.22)}` +
    `C${r(cx - b * 0.86)} ${r(cy - h * 0.62)} ${r(cx + b * 0.86)} ${r(cy - h * 0.62)} ${r(cx + b)} ${r(cy - h * 0.22)}` +
    `C${r(cx + b * 0.78)} ${r(cy + h * 0.2)} ${r(cx + b * 0.34)} ${r(cy + h * 0.46)} ${r(cx)} ${r(cy + h * 0.5)}` +
    `C${r(cx - b * 0.34)} ${r(cy + h * 0.46)} ${r(cx - b * 0.78)} ${r(cy + h * 0.2)} ${r(cx - b)} ${r(cy - h * 0.22)}Z`
  );
}

/* Der Koerper, nachgebaut nach der Vorlage des Betreibers.
   Entscheidend ist die Groesse der Deckblaetter: WENIGE und GROSSE. Frueher
   waren es sechs Lagen mit bis zu drei kleinen Schuppen — das ergibt eine
   Struktur, die man erst beim Heranzoomen liest, und aus der Entfernung ein
   Muster statt einer Pflanze. In der Vorlage sind es fuenf Lagen mit hoechstens
   zwei Blaettern, jedes fast so breit wie die halbe Dolde.

   Das Profil laeuft von oben rund nach unten spitz. Zwei fruehere Fassungen
   sind an genau diesem Punkt gescheitert: gleichmaessig schmaler werdende
   Lagen ergeben einen Tannenzapfen, ein glatter Umriss mit Schuppen darin
   eine Karotte. Richtig ist ein runder Kopf, dann Auslauf. */
const HOPFEN_LAGEN: Array<{ y: number; b: number; h: number; x: number[] }> = [
  /* Das Kopfblatt: eines statt zweier, und so breit wie die ganze Dolde.
     Es macht die Rundung oben. */
  { y: 44, b: 54, h: 100, x: [0] },
  { y: 92, b: 40, h: 82, x: [-24, 24] },
  { y: 132, b: 34, h: 70, x: [-17, 17] },
  { y: 168, b: 27, h: 56, x: [-10, 10] },
  { y: 196, b: 18, h: 40, x: [0] },
];

/* `rand` markiert, was den Umriss bildet: die aeusserste Schuppe jeder Lage.
   Sie leuchtet kraeftig, was dazwischen sitzt bleibt zurueck. */
const hopfenPfade = HOPFEN_LAGEN.flatMap(({ y, b, h, x }) =>
  x.map((dx, i) => ({
    d: schuppe(dx, y, b, h),
    rand: i === 0 || i === x.length - 1,
    voll: true,
  })),
);

const HOPFEN = {
  /* Reihenfolge ist hier Bildaufbau, nicht Geschmackssache: was spaeter
     kommt, liegt vorn und verdeckt das Dahinterliegende. Ohne diese
     Verdeckung kreuzen sich alle Umrisse und die Dolde wird zum Gitter. */
  pfade: [
    /* Der Stiel schwingt aus dem Kopf heraus, statt gerade abzustehen. Er ist
       eine offene Linie und keine Flaeche — in der Vorlage ist er ein Strich
       derselben Staerke wie die Umrisse. */
    { d: 'M4-16C26-42 56-58 82-66', rand: true, voll: false },
    ...hopfenPfade,
  ],
  box: '-70 -76 162 300',
};

/* ---------------------------------------------------------------------------
   Gerstenaehre

   Erkennbar wird die Aehre durch zwei Dinge: die paarweise am Halm sitzenden
   Koerner und die sehr langen Grannen, die weit darueber hinausstehen. Eine
   Aehre ohne Grannen sieht aus wie ein Grashalm — deshalb sind sie hier
   bewusst lang und zahlreich.
------------------------------------------------------------------------- */

/** Ein Korn: laengliche Spindel vom Halm schraeg nach oben aussen. */
function korn(s: number, y: number, l: number) {
  const sx = s * l * 0.62;
  const sy = y - l * 0.42;
  return (
    /* Die beiden Kanten muessen deutlich auseinanderlaufen. Ein erster
       Versuch fuehrte sie zu eng: bei zwei Strichen von 2 px blieb dazwischen
       fast nichts frei, und das Korn wirkte wie ein massiver dunkler Keil
       statt wie eine Spindel. */
    `M0 ${r(y + l * 0.55)}` +
    `C${r(s * l * 0.4)} ${r(y + l * 0.28)} ${r(s * l * 0.7)} ${r(y - l * 0.08)} ${r(sx)} ${r(sy)}` +
    `C${r(s * l * 0.3)} ${r(y - l * 0.16)} ${r(s * l * 0.04)} ${r(y + l * 0.26)} 0 ${r(y + l * 0.55)}Z`
  );
}

/** Die Granne: setzt an der Kornspitze an und laeuft weit nach oben aussen. */
function granne(s: number, y: number, l: number, laenge: number) {
  const sx = s * l * 0.62;
  const sy = y - l * 0.42;
  const ex = s * (l * 0.62 + laenge * 0.42);
  const ey = sy - laenge;
  return `M${r(sx)} ${r(sy)}C${r(sx + s * laenge * 0.06)} ${r(sy - laenge * 0.42)} ${r(ex - s * laenge * 0.16)} ${r(ey + laenge * 0.34)} ${r(ex)} ${r(ey)}`;
}

/** Mittelrippe im Korn. */
function rippe(s: number, y: number, l: number) {
  return `M0 ${r(y + l * 0.5)}C${r(s * l * 0.14)} ${r(y + l * 0.06)} ${r(s * l * 0.4)} ${r(y - l * 0.16)} ${r(s * l * 0.58)} ${r(y - l * 0.38)}`;
}

/* Sieben Kornpaare. Die mittleren sind am groessten, oben und unten laeuft
   die Aehre aus — sonst wirkt sie wie ein Rechteck. */
const GERSTE_PAARE = Array.from({ length: 7 }, (_, i) => {
  const y = 8 + i * 29;
  const mitte = 1 - Math.abs(i - 3) / 4.6;
  return { y, l: 38 + 16 * mitte, laenge: 96 + 44 * mitte };
});

const GERSTE = {
  /* Auch hier ist die Reihenfolge Bildaufbau: erst der Halm, dann die
     Grannen, dann die Koerner darueber. So verschwinden die Grannenansaetze
     hinter den Koernern, statt sie zu durchkreuzen. Die Rippen kommen
     zuletzt, sie liegen auf dem Korn. */
  pfade: [
    { d: 'M0 6V268', rand: false, voll: false },
    ...GERSTE_PAARE.flatMap(({ y, l, laenge }) => [
      { d: granne(-1, y, l, laenge), rand: true, voll: false },
      { d: granne(1, y, l, laenge), rand: true, voll: false },
    ]),
    ...GERSTE_PAARE.flatMap(({ y, l }) => [
      { d: korn(-1, y, l), rand: true, voll: true },
      { d: korn(1, y, l), rand: true, voll: true },
    ]),
    ...GERSTE_PAARE.flatMap(({ y, l }) => [
      { d: rippe(-1, y, l), rand: false, voll: false },
      { d: rippe(1, y, l), rand: false, voll: false },
    ]),
  ],
  box: '-104 -158 208 442',
};

const motiv = art === 'hopfen' ? HOPFEN : GERSTE;
const [, , boxB, boxH] = motiv.box.split(' ').map(Number);
const hoeheCss = typeof hoehe === 'number' ? `${hoehe}px` : hoehe;
/* Die Breite kommt aus dem Seitenverhaeltnis der Zeichenflaeche und nicht
   aus einer Rechnung wie `calc(hoehe * verhaeltnis)`. Der Grund: ein
   Prozentwert in einer Breitenangabe bezieht sich auf die Breite des
   Bezugsrahmens, nicht auf dessen Hoehe. Bei `hoehe="132%"` kam so eine
   Breite von 328 px heraus, wo 151 px richtig gewesen waeren. */
const verhaeltnis = `${boxB} / ${boxH}`;
---

<div
  class:list={['leitmotiv', `leitmotiv-${seite}`, klasse]}
  style={`--motiv-hoehe: ${hoeheCss}; --motiv-verhaeltnis: ${verhaeltnis}; --motiv-drehung: ${drehung}deg; --motiv-ueberstand: ${r(ueberstand * 100)}%;`}
  aria-hidden="true"
>
  {/* Grundzustand: sehr blass, nur Tiefe fuer die Flaeche. */}
  <svg
    class="leitmotiv-grund"
    viewBox={motiv.box}
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      motiv.pfade.map((p) => (
        <path d={p.d} class:list={[p.rand ? 'rand' : 'innen', p.voll && 'voll']} />
      ))
    }
  </svg>

  {/* Goldkopie. Die Maske am umgebenden Element laesst nur den Bereich um
      den Zeiger stehen, alles andere blendet weich aus. */}
  <div class="leitmotiv-licht">
    <svg viewBox={motiv.box} stroke-linecap="round" stroke-linejoin="round">
      {/* Der Hof. Ungefuellt und weichgezeichnet: dass sich die Umrisse hier
          kreuzen, sieht man nach dem Weichzeichnen nicht mehr, und nur so
          entsteht ein Schein, der ueber den Umriss hinausreicht. */}
      <g class="licht-hof">{motiv.pfade.map((p) => <path d={p.d} />)}</g>
      {/* Die scharfe Zeichnung, gefuellt und in derselben Reihenfolge wie
          der Grund — sonst deckt sie ihn nicht sauber ab. */}
      {
        motiv.pfade.map((p) => (
          <path d={p.d} class:list={[p.rand ? 'rand' : 'innen', p.voll && 'voll']} />
        ))
      }
    </svg>
  </div>
</div>

<style>
  .leitmotiv {
    position: absolute;
    top: 50%;
    /* Bewusst 0 und nicht negativ: bei negativem z-index liegt das Motiv
       hinter der Flaeche des Abschnitts und ist fuer den Zeiger gar nicht
       erreichbar, der Lichtpunkt koennte nie ausloesen. Der Inhalt bekommt
       stattdessen z-index 1 und liegt damit darueber. */
    z-index: 0;
    height: var(--motiv-hoehe);
    aspect-ratio: var(--motiv-verhaeltnis);
    width: auto;
    transform: translateY(-50%) translateX(var(--motiv-versatz, 0)) rotate(var(--motiv-drehung));

    /* Startwert, bis der Zeiger das erste Mal gemeldet wird. Auch der
       Ruhewert fuer alle, die keinen Zeiger haben. */
    --licht-x: 50%;
    --licht-y: 45%;
    /* Gross genug, dass der Rand des Lichts weit ausserhalb des Blickfelds
       liegt und man keinen Kreis wahrnimmt, klein genug, dass es immer noch
       ein Ort ist und keine allgemeine Aufhellung. */
    --licht-radius: 240px;
  }

  /* Das Hochlegen des Inhalts passiert in der jeweiligen Seite, weil die
     Verschachtelung dort unterschiedlich ist. */

  /* Ragt bewusst ueber den Rand hinaus: ein angeschnittenes Motiv wirkt
     wie ein Ausschnitt aus etwas Groesserem, ein vollstaendiges wie ein
     aufgeklebtes Bild.
     Der Ueberstand kommt aus einer Verschiebung und nicht aus `right`, weil
     die Breite hier vom Seitenverhaeltnis abgeleitet wird und in CSS damit
     nicht als Zahl vorliegt. Ein Prozentwert in `translateX` bezieht sich
     dagegen auf die eigene Breite des Elements. */
  .leitmotiv-rechts {
    right: 0;
    --motiv-versatz: var(--motiv-ueberstand);
  }

  .leitmotiv-links {
    left: 0;
    --motiv-versatz: calc(var(--motiv-ueberstand) * -1);
  }

  /* Fuer Paare: kein eigener Bezug, kein Ueberstand, keine Zentrierung —
     nur die Groesse und die Drehung bleiben. Die Anordnung macht die Seite. */
  .leitmotiv-frei {
    position: relative;
    top: auto;
    transform: rotate(var(--motiv-drehung));
  }

  .leitmotiv svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Verdeckung. Die Fuellung hat die Farbe der Seitenflaeche, damit ein
     Deckblatt alles verbirgt, was hinter ihm liegt. Genau das trennt eine
     Zeichnung von einem Liniengitter. Offene Pfade — Halm, Grannen, Rippen —
     bleiben ungefuellt, sonst entstehen Fantasieflaechen zwischen ihren
     Enden. */
  .leitmotiv path {
    fill: none;
  }

  .leitmotiv path.voll {
    fill: var(--db-flaeche);
  }

  .leitmotiv-grund .rand {
    stroke-width: 2.6;
  }

  .leitmotiv-grund .innen {
    stroke-width: 2;
  }

  .leitmotiv-grund {
    transition: opacity var(--db-dauer-ruhig) var(--db-easing-standard);
  }

  /* Warmes Braun, sehr blass. Kraeftig genug, dass man das Motiv findet,
     ohne dass es mit dem Text konkurriert.

     Es gab zwischenzeitlich eine helle Fassung fuer Motive auf Fotos. Sie
     ist entfallen: seit die Deckblaetter sich gegenseitig verdecken, ist die
     Fuellung die Farbe der Seitenflaeche, und die stimmt auf einem Foto
     nicht. Ein Motiv gehoert damit auf eine ruhige Flaeche — was ohnehin die
     bessere Wahl ist, wie der Versuch im Hero-Bild gezeigt hat. */
  .leitmotiv-grund {
    color: var(--db-malz-700);
    opacity: 0.15;
  }

  /* -------------------------------------------------------------------------
     Der Lichtpunkt
     ---------------------------------------------------------------------- */

  .leitmotiv-licht {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* Diese Dauer gilt beim Verlassen. Sie ist bewusst lang: das Licht soll
       verloeschen wie eine weggetragene Lampe, nicht abgeschaltet werden. */
    transition: opacity 760ms var(--db-easing-standard);

    /* Der eigentliche Effekt. Bewusst nirgends voll deckend: schon am Zeiger
       bleibt die Maske bei 0,62, sodass das Gold immer durchscheinend wirkt
       statt aufgemalt. Ein erster Versuch ging bis 1,0 und war dem Betreiber
       deutlich zu kraeftig.
       Die vielen Stufen sind Absicht: mit nur zwei Stopps entsteht ein
       harter Kreisrand, der wie ein Loch aussieht statt wie Licht. */
    --licht-verlauf: radial-gradient(
      circle var(--licht-radius) at var(--licht-x) var(--licht-y),
      rgb(0 0 0 / 0.62) 0%,
      rgb(0 0 0 / 0.55) 22%,
      rgb(0 0 0 / 0.38) 44%,
      rgb(0 0 0 / 0.18) 64%,
      rgb(0 0 0 / 0.06) 82%,
      rgb(0 0 0 / 0) 100%
    );
    -webkit-mask-image: var(--licht-verlauf);
    mask-image: var(--licht-verlauf);
  }

  .leitmotiv[data-licht] .leitmotiv-licht {
    opacity: 1;
    /* Beim Betreten etwas zuegiger als beim Verlassen, aber immer noch
       ruhig genug, dass nichts aufblitzt. */
    transition-duration: var(--db-dauer-ruhig);
  }

  .leitmotiv[data-licht] .leitmotiv-grund {
    opacity: 0.18;
  }


  /* Der weiche Hof um die Linien. Bewusst als eigene, weichgezeichnete Lage
     und nicht als `drop-shadow` auf den gefuellten Pfaden: ein Schlagschatten
     nimmt die Deckkraft der ganzen Form, ergaebe also einen verwaschenen
     Klecks in Doldenform statt eines Scheins entlang der Linien. */
  .licht-hof {
    fill: none;
    stroke: #e8b871;
    stroke-width: 7;
    opacity: 0.4;
    filter: blur(7px);
  }

  /* Die Kanten tragen den Effekt. Der Strich ist nicht breiter als in der
     Grundzeichnung — er soll die Linie zum Glimmen bringen, nicht verdicken.
     Ein erster Versuch mit 3,4 px und drei kraeftigen Schatten sah aus wie
     eine Leuchtreklame. */
  .leitmotiv-licht .rand {
    /* Goldgelb, nicht Creme. Eine sehr helle Linie liest sich als weiss,
       sobald ein Schein darum liegt; erst mit Farbe im Strich selbst wirkt
       es wie Metall. */
    stroke: #e5b455;
    stroke-width: 2.6;
  }

  /* Die Binnenzeichnung bleibt deutlich zurueck. Sonst leuchtet die ganze
     Flaeche und der Umriss geht darin unter. */
  .leitmotiv-licht .innen {
    stroke: var(--db-bernstein-300);
    stroke-width: 2;
    stroke-opacity: 0.45;
  }

  @media (max-width: 899px) {
    /* Auf schmalen Bildschirmen ist kein Platz fuer ein grosses Motiv am
       Rand: es laege hinter dem Text statt daneben. */
    .leitmotiv {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .leitmotiv-grund,
    .leitmotiv-licht {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Fuehrt den Lichtpunkt am Zeiger nach.
   *
   * Gesetzt werden nur zwei eigene Eigenschaften, und zwar direkt am Motiv.
   * Eine Eigenschaft weiter oben im Baum wuerde alle Nachfahren zur
   * Neuberechnung zwingen; hier ist der Teilbaum genau ein Element gross.
   */
  const feiner = window.matchMedia('(hover: hover) and (pointer: fine)');
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const motiv of document.querySelectorAll<HTMLElement>('.leitmotiv')) {
    if (!feiner.matches) continue;

    motiv.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      motiv.dataset.licht = '';
    });

    motiv.addEventListener('pointerleave', () => {
      delete motiv.dataset.licht;
    });

    /* Bei reduzierter Bewegung bleibt das Licht in der Mitte stehen: der
       Effekt ist dann eine ruhige Aufhellung, kein wanderndes Objekt. */
    if (ruhig.matches) continue;

    let angefordert = 0;
    let x = 0;
    let y = 0;

    const setzen = () => {
      angefordert = 0;
      motiv.style.setProperty('--licht-x', `${x}px`);
      motiv.style.setProperty('--licht-y', `${y}px`);
    };

    motiv.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      /* Das Motiv ist gedreht. Ohne Ruecktransformation saesse das Licht
         schief zum Zeiger, weil die Maske im gedrehten Raum liegt. */
      const kasten = motiv.getBoundingClientRect();
      const winkel =
        (-parseFloat(getComputedStyle(motiv).getPropertyValue('--motiv-drehung')) || 0) *
        (Math.PI / 180);
      const mx = e.clientX - (kasten.left + kasten.width / 2);
      const my = e.clientY - (kasten.top + kasten.height / 2);
      x = motiv.offsetWidth / 2 + (mx * Math.cos(winkel) - my * Math.sin(winkel));
      y = motiv.offsetHeight / 2 + (mx * Math.sin(winkel) + my * Math.cos(winkel));
      if (!angefordert) angefordert = requestAnimationFrame(setzen);
    });
  }
</script>

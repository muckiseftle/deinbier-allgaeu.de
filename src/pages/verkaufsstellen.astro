---
import { getCollection } from 'astro:content';

import Themenseite from '../layouts/Themenseite.astro';
import Abschnitt from '../komponenten/basis/Abschnitt.astro';
import Knopf from '../komponenten/basis/Knopf.astro';
import Anfahrtskarte from '../komponenten/marke/Anfahrtskarte.astro';
import { Icon } from 'astro-icon/components';
import { nachSchluessel } from '../lib/gruppieren';
import { BETRIEB } from '../daten/betrieb';

import leitbild from '../bilder/kiste-helles.png';

const alle = (await getCollection('verkaufsstellen')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);

const abHof = alle.find((s) => s.data.abHof);
const uebrige = alle.filter((s) => !s.data.abHof);

const REGIONEN = ['Ostallgäu', 'Unterallgäu', 'Weilheim-Schongau', 'Landsberg am Lech'];
const gruppen = nachSchluessel(uebrige, (s) => s.data.region, REGIONEN);

/* Routenplaner auf OpenStreetMap statt Google Maps: ein Link, der erst auf
   Klick etwas tut, uebertraegt beim Seitenaufruf nichts. */
const routeUrl = `https://www.openstreetmap.org/search?query=${encodeURIComponent(
  `${BETRIEB.strasse}, ${BETRIEB.plz} ${BETRIEB.ort}`,
)}`;
---

<Themenseite
  motiv="hopfen"
  titel="Verkaufsstellen"
  beschreibung="Wo es DEIN BIER gibt: Brauereiverkauf ab Hof in Hausen sowie sechzehn Verkaufsstellen im Allgäu und Umgebung."
  ueberschrift="Wo es DEIN BIER gibt"
  vorspann="Im Brauereiverkauf ab Hof und bei unseren Vertriebspartnern. Bei manchen lohnt sich eine Vorbestellung."
  leitbild={leitbild}
  leitbildAlt="Ein 16er Holzträger DEIN BIER Helles"
  abschlussTitel="Etwas Bestimmtes gesucht?"
>
  {/* ---------- Ab Hof ---------- */}
  {
    abHof && (
      <Abschnitt>
        <div class="abhof">
          <div>
            <p class="etikettenzeile">Direkt bei uns</p>
            <h2>{abHof.data.name}</h2>
            <address>
              {abHof.data.strasse}
              <br />
              {abHof.data.plz} {abHof.data.ort}
            </address>
            {abHof.data.hinweis && <p class="abhof-zeiten">{abHof.data.hinweis}</p>}
            <div class="abhof-knoepfe">
              <Knopf href={routeUrl} extern={true}>
                Route planen
              </Knopf>
              <Knopf href={`tel:${BETRIEB.telefon}`} art="still">
                {BETRIEB.telefonAnzeige}
              </Knopf>
            </div>
          </div>
          <Anfahrtskarte />
        </div>
      </Abschnitt>
    )
  }

  {/* ---------- Nach Region ---------- */}
  <Abschnitt
    titel="Bei unseren Partnern"
    vorspann="Sechzehn Verkaufsstellen im Allgäu und Umgebung."
  >
    {
      gruppen.map((gruppe) => (
        <div class="region">
          <h3 class="region-titel">{gruppe.name}</h3>
          <div class="stellen">
            {gruppe.eintraege.map((s, i) => (
              <article class="stelle einblenden" style={`--index: ${i}`}>
                <h4>{s.data.name}</h4>
                <address>
                  {s.data.strasse}
                  <br />
                  {s.data.plz} {s.data.ort}
                </address>
                {s.data.hinweis && <p class="stelle-hinweis">{s.data.hinweis}</p>}
                {s.data.website && (
                  <p class="stelle-link">
                    <a href={s.data.website} rel="noopener noreferrer" target="_blank">
                      Website <span aria-hidden="true">↗</span>
                      <span class="sr-only">(öffnet in neuem Tab)</span>
                    </a>
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </Abschnitt>

  {/* ---------- Gebinde ---------- */}
  <Abschnitt titel="In welchen Gebinden">
    <ul class="gebindeliste">
      <li>
        <Icon name="ph:map-pin" width="20" height="20" aria-hidden="true" />
        16er Holzträger
      </li>
      <li>
        <Icon name="ph:map-pin" width="20" height="20" aria-hidden="true" />
        6er Träger, 0,3&nbsp;l
      </li>
      <li>
        <Icon name="ph:map-pin" width="20" height="20" aria-hidden="true" />
        Fass 10, 20, 30 und 50&nbsp;l
      </li>
      <li>
        <Icon name="ph:map-pin" width="20" height="20" aria-hidden="true" />
        5-l-Dose, im Sommer
      </li>
    </ul>
    <p class="gebinde-hinweis">
      Bei den Partnern lohnt sich je nach Sorte eine Vorbestellung. Preise
      erfahrt Ihr im Brauereiverkauf.
    </p>
  </Abschnitt>
</Themenseite>

<style>
  .abhof {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--db-space-xl);
    align-items: center;
  }

  .abhof address {
    font-style: normal;
    margin-top: var(--db-space-sm);
  }

  .abhof-zeiten {
    margin-top: var(--db-space-sm);
    max-width: 28rem;
  }

  .abhof-knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--db-space-sm);
    margin-top: var(--db-space-md);
  }

  @media (max-width: 899px) {
    .abhof {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .region + .region {
    margin-top: var(--db-space-2xl);
  }

  .region-titel {
    font-family: var(--db-font-text);
    font-size: var(--db-text-lg);
    font-weight: var(--db-weight-medium);
    letter-spacing: var(--db-tracking-weit);
    text-transform: uppercase;
    color: var(--db-text-leise);
    padding-bottom: var(--db-space-2xs);
    border-bottom: 1px solid var(--db-linie);
  }

  /* Karten statt sechzehn Zeilen mit einer Haarlinie unter jeder davon. */
  .stellen {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--db-space-md);
    margin-top: var(--db-space-lg);
  }

  .stelle {
    background: var(--karte-flaeche);
    border-radius: var(--karte-radius);
    padding: var(--db-space-md);
  }

  .stelle h4 {
    font-size: var(--db-text-lg);
  }

  .stelle address {
    font-style: normal;
    margin-top: var(--db-space-2xs);
    font-size: var(--db-text-sm);
    color: var(--db-text-leise);
  }

  .stelle-hinweis {
    margin-top: var(--db-space-2xs);
    font-size: var(--db-text-sm);
    color: var(--db-text-hinweis);
  }

  .stelle-link {
    margin-top: var(--db-space-sm);
    font-size: var(--db-text-sm);
  }

  @media (max-width: 999px) {
    .stellen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .stellen {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .gebindeliste {
    list-style: none;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--db-space-md);
  }

  .gebindeliste li {
    display: flex;
    align-items: center;
    gap: var(--db-space-2xs);
    background: var(--db-flaeche-ruhig);
    border-radius: var(--db-radius-md);
    padding: 0.4rem 0.9rem;
  }

  .gebindeliste :global(svg) {
    color: var(--db-linie-zier);
  }

  .gebinde-hinweis {
    margin-top: var(--db-space-lg);
    max-width: var(--db-mass-text);
    color: var(--db-text-leise);
  }
</style>

---
import '../styles/schriften.css';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/basis.css';
import '../styles/layout.css';
import '../styles/knoepfe.css';

import Sprungmarke from '../komponenten/basis/Sprungmarke.astro';
import Kopfzeile from '../komponenten/kopf/Kopfzeile.astro';
import Fusszeile from '../komponenten/fuss/Fusszeile.astro';
import Altersabfrage from '../komponenten/Altersabfrage.astro';
import Meta from '../komponenten/seo/Meta.astro';
import JsonLd from '../komponenten/seo/JsonLd.astro';

interface Props {
  titel: string;
  beschreibung: string;
  bildPfad?: string;
  nichtIndexieren?: boolean;
  jsonLdZusatz?: Record<string, unknown>[];
}

const { titel, beschreibung, bildPfad, nichtIndexieren, jsonLdZusatz } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    {/* Kein maximum-scale, kein user-scalable=no: das sperrt den Zoom und
        verstoesst gegen WCAG 1.4.4. Die Altseite macht genau diesen Fehler. */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#523816" />

    <Meta
      titel={titel}
      beschreibung={beschreibung}
      bildPfad={bildPfad}
      nichtIndexieren={nichtIndexieren}
    />
    <JsonLd zusatz={jsonLdZusatz} />

    {/* Nur die zwei Schriften, die den ersten Bildschirm tragen. Die kursive
        Fassung wird erst fuer Zitate und die Signaturzeile gebraucht, beides
        unterhalb des ersten Bildschirms. */}
    <link
      rel="preload"
      href="/schriften/vollkorn-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/schriften/work-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Favicon-Set. PLATZHALTER: aus dem 300-px-PNG erzeugt, die grossen
        Groessen sind daher hochskaliert. Neu erzeugen, sobald die
        Vektordatei vorliegt (werkzeuge/favicons.ps1). */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Scrollgebundene Bewegung des Lichtpunkts an den Leitmotiven, fuer
        Geraete ohne Zeiger.

        Warum hier und unverarbeitet (`is:inline`) statt in der Komponente:
        der CSS-Minifizierer entfernt `animation-timeline` ersatzlos, weil es
        ausserhalb seiner Zielbrowser liegt. In der Komponente stand die Regel
        richtig da und fehlte im Bauergebnis vollstaendig — aufgefallen ist
        das erst beim Nachsehen im gebauten CSS, nicht im Quelltext. Zuvor
        hatte derselbe Minifizierer `animation-timeline` sogar in die
        Kurzschreibweise `animation` hineingefaltet, wo sie nicht hingehoert.

        Versuche mit `build.cssTarget` und mit eigenen Zielangaben fuer den
        Minifizierer haben beide nichts geaendert.

        Ohne Unterstuetzung fuer scrollgebundene Animationen steht das Licht
        still in der Mitte des Motivs — dann ist es ein ruhiger Goldschimmer
        statt eines wandernden. Kein Fehlbild. */}
    <style is:inline>
      @media (hover: none) {
        .leitmotiv {
          animation-name: licht-wandern;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: cover 0% cover 100%;
        }
      }

      @keyframes licht-wandern {
        from {
          --licht-y: -5%;
        }
        to {
          --licht-y: 105%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .leitmotiv {
          animation-name: none;
        }
      }
    </style>
  </head>

  <body>
    <Sprungmarke />
    <Kopfzeile />

    <main id="inhalt">
      <slot />
    </main>

    <Fusszeile />
    <Altersabfrage />

    <div class="korn" aria-hidden="true"></div>

    <script>
      /* Einblenden beim Scrollen. IntersectionObserver statt Scroll-Ereignis:
         ein Scroll-Listener laeuft bei jedem Bild neu und erzwingt dauerndes
         Nachrechnen. */
      const beobachtete = document.querySelectorAll('.einblenden');
      const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (beobachtete.length > 0 && !wenigerBewegung) {
        const beobachter = new IntersectionObserver(
          (eintraege) => {
            for (const eintrag of eintraege) {
              if (eintrag.isIntersecting) {
                eintrag.target.classList.add('sichtbar');
                beobachter.unobserve(eintrag.target);
              }
            }
          },
          { threshold: 0.2 },
        );
        beobachtete.forEach((el) => beobachter.observe(el));
      } else {
        /* Ohne diesen Zweig blieben bei reduzierter Bewegung alle Abschnitte
           unsichtbar, weil .einblenden mit opacity 0 startet. */
        beobachtete.forEach((el) => el.classList.add('sichtbar'));
      }
    </script>
  </body>
</html>
